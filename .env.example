# Optional hosted Scribe transcription. Local Whisper needs no key.
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
# Optional explicit Chrome location; otherwise HyperFrames manages Chrome.
HYPERFRAMES_BROWSER_PATH=
# Optional font overrides for Linux/macOS/custom fonts.
VIDEO_FONT=
VIDEO_FONT_BOLD=
# Opt in only if your GoPro recording suits Govind's measured repair preset.
VIDEO_GOPRO_REPAIR=0
